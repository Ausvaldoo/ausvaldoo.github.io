# 依赖与构建产物
node_modules/
dist/
# 旧构建目录。构建前会把 dist 改名让开（某些受限环境里没法直接清空 dist），
# 留下的是 dist_old_<时间戳>。发布命令是 `git add -A`，不挡一下会被整包提交。
dist_old_*/

# VitePress 缓存与数据加载器临时文件
.vitepress/cache/
.vitepress/.temp/
*.timestamp-*.mjs

# Obsidian 工作区（配置含本机路径，且 workspace.json 变动频繁）
.obsidian/
.trash/

# Obsidian 粘贴到仓库根目录的孤儿图片：默认不入库。
# 要正式用图，请把文件放进 public/images/ 再用 ![](/images/xxx.png) 引用。
/Pasted image *.png

# AI 协作产生的项目记忆（.workbuddy/memory/*.md）。
# 里面是内部判断与决策过程，而这是公开仓库 —— 发布命令是 `git add -A`，不挡住会被整个提交上去。
.workbuddy/

# 历史工作区 _ws/（探针脚本 / 截图 / 视频 / 抓取样本，约 279MB）。
# 它是工具留档不是博客内容：里面的 .md 既不发布也不入库。
# 发布命令是 `git add -A`，不挡一下整包会被提交上去。
_ws/

# 系统杂项
Thumbs.db
.DS_Store
*.local
